{
  "name": "nethack-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build:wasm": "scripts/build-wasm.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "E2E_UPDATE=1 playwright test update.spec",
    "test:e2e:upload": "pnpm --dir ../nethack-server run build && pnpm --dir ../nethack-server exec firebase emulators:exec --project demo-nethack --only auth,firestore,functions,storage --log-verbosity QUIET \"cd ../nethack-web && E2E_UPLOAD=1 pnpm exec playwright test upload.spec\""
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
